{%- extends "roro/base.html.twig" -%}
{%- set translation_prefix = 'roro.bookmarked-routes' -%}

{%- block content -%}
    <h1 class="govuk-heading-l govuk-!-margin-bottom-2">{{ 'roro.bookmarked-routes.title' | trans }}</h1>
    <p class="govuk-body govuk-!-margin-bottom-8">
        Bookmarking routes will display them more prominently on the dashboard, allowing for quick and easy access.<br>

        This is especially useful if you are only responsible for submitting surveys for some of your company's routes.
    </p>

    <h2 class="govuk-heading-m">{{ 'roro.bookmarked-routes.bookmarked-routes' | trans }}</h2>
    {{- _self.routeList(
        toggleMappings,
        routes | filter(route => route.isBookmarked),
        'roro.bookmarked-routes.remove-bookmark',
        'roro.bookmarked-routes.no-bookmarked-routes'
    ) -}}

    <h2 class="govuk-heading-m">{{ 'roro.bookmarked-routes.other-routes' | trans }}</h2>
    {{- _self.routeList(
        toggleMappings,
        routes | filter(route => not route.isBookmarked),
        'roro.bookmarked-routes.bookmark',
        'roro.bookmarked-routes.no-other-routes'
    ) -}}

    {{ form(form) }}
{%- endblock -%}

{%- macro routeList(toggleMappings, routes, linkTranslationString, noneTranslationString) -%}
    {%- from '@GhostGovUkFrontend/components/macros.html.twig' import actionlessSummaryListRow, summaryListRow -%}

    <dl class="govuk-summary-list govuk-!-margin-bottom-9">
        {%- for routePair in routes -%}
            {%- set route = routePair.route -%}
            {{- summaryListRow(
                "#{route.ukPort.name} to #{route.foreignPort.name}",
                null,
                {
                    (path('app_roro_bookmarked_routes', {mapping: toggleMappings[route.id]})): linkTranslationString,
                },
                {
                    key_translation: false,
                }
            ) -}}
        {%- else -%}
            {{- actionlessSummaryListRow(noneTranslationString) }}
        {%- endfor -%}
    </dl>
{%- endmacro -%}