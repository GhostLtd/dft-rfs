{% extends 'admin/report/report-base.html.twig' %}

{% set translation_prefix = "admin.reports.state" %}

{% block statsTable %}
    {%- if type == 'irhs' -%}
        {{- _self.displayIrhs(stateMappings, stats) -}}
    {%- else -%}
        {{- _self.displayCsrgt(stateMappings, stats) -}}
    {%- endif -%}
{% endblock %}

{% macro displayCsrgt(stateMappings, stats) %}
    {% for year, yearStats in stats %}
        {{ _self.displayTable(stateMappings, yearStats.data, yearStats.totals, yearStats.total) }}
    {% endfor %}
{% endmacro %}

{% macro displayIrhs(stateMappings, stats) %}
    {{ _self.displayTable(stateMappings, stats.data, stats.totals, stats.total) }}
{% endmacro %}

{% macro displayTable(stateMappings, stats, totals, totalOfTotals) %}
    <details class="govuk-details" data-module="govuk-details">
        <summary class="govuk-details__summary">
    <span class="govuk-details__summary-text">
      Column mappings
    </span>
        </summary>
        <div class="govuk-details__text">
            <table class="govuk-table">
                <tbody class="govuk-table__body">
                {%- from '@GhostGovUkFrontend/components/macros.html.twig' import tag -%}
                {%- for state, mappings in stateMappings -%}
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header">{{ state|capitalize }}</th>
                    <td class="govuk-table__cell">
                        {% for mapping in mappings %}
                            {{- tag({text: mapping, classes: "admin.survey.state.#{mapping}" | trans}) -}}{{- ' ' -}}
                        {% endfor %}
                    </td>
                </tr>
                {%- endfor -%}
                </tbody>
            </table>
        </div>
    </details>
    <table class="govuk-table rfs-admin-report-table">
        <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Week</th>
            {% for state in stateMappings|keys %}
            <th scope="col" class="govuk-table__header">{{ state|capitalize }}</th>
            {% endfor %}
            <th scope="col" class="govuk-table__header">Total</th>
        </tr>
        </thead>
        <tbody class="govuk-table__body">
        {% import "admin/report/macros.html.twig" as m %}
        {% dump stateMappings %}
        {% set fields = stateMappings|keys %}
        {% for week, weekStats in stats %}
            {%- set allZeros = weekStats.allZeros -%}
            <tr class="govuk-table__row">
                <td class="govuk-table__header">{{ week }}</td>
                {{ m.displayRow(weekStats.data, weekStats.total, weekStats.allZeros, fields) }}
            </tr>
        {% endfor %}
        <tr class="govuk-table__row">
            <td class="govuk-table__header">Total</td>
            {{ m.displayRow(totals, totalOfTotals, false, fields) }}
        </tr>
        </tbody>
    </table>
{% endmacro %}