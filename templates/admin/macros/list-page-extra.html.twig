{%- macro countField(survey, fieldName) -%}
    {%- set field = survey.response ? attribute(survey.response, fieldName) : null -%}
    {{- (field == null or field == 0) ? '-' : field -}}
{%- endmacro -%}

{%- macro reminderDate(value, recursiveValue) -%}
    {%- if value | default(false) -%}
        {%- if ((value | date('Y-m-d')) == '1970-01-01') -%}
            -
        {%- else -%}
            {{- value | date('format.date.default' | trans) -}}
            {%- if recursiveValue | default(false) %}, {{ _self.reminderDate(recursiveValue) }}{% endif -%}
        {%- endif -%}
    {%- else -%}
        -
    {%- endif -%}
{%- endmacro -%}

{#- A list page's Delivery cell: the number of delivery problems, red while any are unseen -#}
{%- macro deliveryProblems(counts) -%}
    {%- from '@GhostGovUkFrontend/components/macros.html.twig' import tag -%}
    {%- if counts.count | default(0) > 0 -%}
        {{- tag({text: counts.count, classes: (counts.unseen > 0 ? 'govuk-tag--red' : 'govuk-tag--green') ~ ' delivery-problems'}) -}}
    {%- else -%}
        —
    {%- endif -%}
{%- endmacro -%}
