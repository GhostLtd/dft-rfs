{%- from '@GhostGovUkFrontend/components/macros.html.twig' import actionlessSummaryListRow as row -%}
<h2 class="govuk-heading-m">Notes</h2>
<dl class="govuk-summary-list govuk-!-margin-bottom-{{ marginBottom ?? 9 }} govuk-summary-list-notes">
    {%- for note in survey.notes -%}
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">
                {{- note.createdBy | removeEmailNamespacePrefix -}}
                <div class="govuk-summary-list-notes__timestamp">{{- note.createdAt | date('format.date.date-time' | trans([], 'admin')) -}}</div>
            </dt>
            <dd class="govuk-summary-list__value">{{ note.note | nl2br }}</dd>
        </div>
    {%- else -%}
        No notes
    {%- endfor -%}
</dl>
{% if addNoteForm is defined %}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-three-quarters-from-desktop govuk-grid-column-one-half-from-wide">
        {{ form(addNoteForm) }}
    </div>
</div>
{% endif %}
