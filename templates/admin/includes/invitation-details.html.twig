{%- from '@GhostGovUkFrontend/components/macros.html.twig' import summaryListStart, summaryListEnd, summaryListRow, tag -%}
{% set indentClass = 'govuk-!-padding-left-5' -%}

<h2 class="govuk-heading-m">Invitation/Reminder details</h2>
{{- summaryListStart({classes: 'govuk-!-margin-bottom-' ~ (marginBottom ?? 9)}) -}}
    {%- set address = survey.invitationAddress and survey.invitationAddress.filled ? survey.invitationAddress : null %}
    {{- summaryListRow({key: {text: 'Address', classes: indentClass}, value: address | formatAddress(true) | default('-')}) -}}
    {% if showEmails ?? true %}
        {{- summaryListRow({key: {text: 'Email Address', classes: indentClass}, value: {html: _self.combinedEmailDisplay(survey.arrayOfInvitationEmails, lcniInfo | default({}))}}) -}}
    {% endif %}
{{- summaryListEnd() -}}

{% for group in notification_types_for(survey, showEmails ?? true) %}
    {% if group.rows | length > 0 or group.type.value in ['invite', 'reminder-1', 'reminder-2'] %}
        {{- summaryListStart({classes: 'govuk-!-margin-bottom-' ~ (marginBottom ?? 9)}) -}}
            {{- summaryListRow({key: {text: group.label, classes: indentClass}, value: group.rows | length > 0 ? '' : '-'}) -}}
            {% for row in group.rows %}
                {{- summaryListRow({
                    key: {text: row.label, classes: indentClass ~ ' govuk-!-padding-left-7'},
                    value: {html: _self.notificationStatus(row.notification, row.notification.channel.value != 'letter')}
                }) -}}
            {% endfor %}
        {{- summaryListEnd() -}}
    {% endif %}
{% endfor %}

{%- macro combinedEmailDisplay(invitationEmails, lcniInfo) -%}
    {%- from '@GhostGovUkFrontend/components/macros.html.twig' import tag -%}
    {%- set hasContent = false -%}
    {%- set hasLocalEmails = invitationEmails | length > 0 -%}

    {# Local invitation emails #}
    {%- for email in invitationEmails -%}
        {%- set hasContent = true -%}
        <div class="govuk-!-margin-bottom-1">
            {%- if is_email_blacklisted(email) %}{{ tag({text: 'Blacklisted', classes: 'govuk-tag--red'}) }} {% endif -%}
            {{- email }}
        </div>
    {%- endfor -%}

    {# LCNI locked state #}
    {%- if lcniInfo.locked ?? false -%}
        {%- set hasContent = true -%}
        <div class="govuk-!-margin-bottom-1{% if hasLocalEmails %} govuk-!-margin-top-2{% endif %}">{{ tag({text: 'LCNI', classes: 'govuk-tag--yellow'}) }} Lookup temporarily unavailable; DVLA sample import in progress</div>
    {# LCNI emails with tag #}
    {%- elseif lcniInfo.emails ?? false -%}
        {%- for email in lcniInfo.emails -%}
            {%- set hasContent = true -%}
            <div class="govuk-!-margin-bottom-2{% if loop.first and hasLocalEmails %} govuk-!-margin-top-2{% endif %}">
                {%- if is_email_blacklisted(email) %}{{ tag({text: 'Blacklisted', classes: 'govuk-tag--red'}) }} {% endif -%}
                {{- tag({text: 'LCNI', classes: 'govuk-tag--blue'}) }} {{ email }}
            </div>
        {%- endfor -%}
    {%- endif -%}

    {%- if not hasContent -%}-{%- endif -%}
{%- endmacro -%}

{%- macro notificationStatus(notification, displayRecipient) -%}
    {%- from '@GhostGovUkFrontend/components/macros.html.twig' import tag -%}
    {%- if notification.notifyApiResponses | length == 0 -%}
        <div class="api-response">
            {{- tag({text: 'pending', classes: 'govuk-tag--yellow'}) -}}
            <span class="govuk-body-s">
                <span class="api-response__timestamp">sends {{ notification.sentAt | date('format.date-time.default' | trans) -}}</span>
            </span>
        </div>
    {%- else -%}
        {% for response in notification.notifyApiResponses %}
            <div class="api-response">
                {%- set status = response.data[constant('App\\EventSubscriber\\AlphagovNotifyMessengerSubscriber::STATUS_KEY')] -%}
                {{- tag({text: status, classes: ("admin.notify.status.#{status}" | trans)}) -}}
                <span class="govuk-body-s">
                    <span class="api-response__timestamp">{{ response.timestamp | date('format.date-time.default' | trans) -}}</span>
                    {%- if displayRecipient | default(false) -%}<span class="api-response__recipient">{{ response.recipient }}</span>{% endif %}
                    {%- if status != constant('App\\Utility\\AlphagovNotify\\Reference::STATUS_ACCEPTED') -%}
                        {%- for error in response.data.errors -%}
                            <br>{{- error.error }}: {{ error.message | nl2br -}}
                        {%- endfor -%}
                    {%- endif -%}
                </span>
            </div>
        {% endfor %}
    {%- endif -%}
{%- endmacro -%}
