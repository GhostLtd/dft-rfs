{%- from '@GhostGovUkFrontend/components/macros.html.twig' import summaryListStart, summaryListEnd, summaryListRow, tag -%}

{% set indentClass = 'govuk-!-padding-left-5' -%}

<h2 class="govuk-heading-m">Invitation/Reminder details</h2>
{{- summaryListStart({classes: 'govuk-!-margin-bottom-' ~ (marginBottom ?? 9)}) -}}
    {%- set address = survey.invitationAddress and survey.invitationAddress.filled ? survey.invitationAddress : null %}
    {{- summaryListRow({
        key: {text: 'Address', classes: indentClass},
        value: address | formatAddress(true) | default('-')
    }) -}}

    {{- summaryListRow({
        key: {text: 'Initial invitation', classes: indentClass},
        value: {html: _self.notificationStatus(
            survey.notifyApiResponsesMatching(
                constant('App\\Utility\\AlphagovNotify\\Reference::EVENT_INVITE'),
                'Ghost\\GovUkCoreBundle\\Messenger\\AlphagovNotify\\Letter',
                true
            ),
            pendingNotifications.pendingInviteLetters | default([]),
            false
        )}
    }) -}}
    {{- summaryListRow({
        key: {text: 'Reminder 1', classes: indentClass},
        value: {html: _self.notificationStatus(
            survey.notifyApiResponsesMatching(
                constant('App\\Utility\\AlphagovNotify\\Reference::EVENT_REMINDER_1'),
                'Ghost\\GovUkCoreBundle\\Messenger\\AlphagovNotify\\Letter',
                true
            ),
            pendingNotifications.pendingReminder1Letters | default([]),
            false
        )}
    }) -}}
    {{- summaryListRow({
        key: {text: 'Reminder 2', classes: indentClass},
        value: {html: _self.notificationStatus(
            survey.notifyApiResponsesMatching(
                constant('App\\Utility\\AlphagovNotify\\Reference::EVENT_REMINDER_2'),
                'Ghost\\GovUkCoreBundle\\Messenger\\AlphagovNotify\\Letter',
                true
            ),
            pendingNotifications.pendingReminder2Letters | default([]),
            false
        )}
    }) -}}
{{- summaryListEnd() -}}

{% if showEmails ?? true %}
    {{- summaryListStart({classes: 'govuk-!-margin-bottom-' ~ (marginBottom ?? 9)}) -}}
        {{- summaryListRow({
            key: {text: 'Email Address', classes: indentClass},
            value: {html: _self.combinedEmailDisplay(survey.arrayOfInvitationEmails, lcniInfo)}
        }) -}}

        {{- summaryListRow({
            key: {text: 'Initial invitation', classes: indentClass},
            value: {html: _self.notificationStatus(
                survey.notifyApiResponsesMatching(
                    constant('App\\Utility\\AlphagovNotify\\Reference::EVENT_INVITE'),
                    'Ghost\\GovUkCoreBundle\\Messenger\\AlphagovNotify\\Email',
                    true
                ),
                pendingNotifications.pendingInviteEmails | default([]),
                true
            )}
        }) -}}
        {{- summaryListRow({
            key: {text: 'Reminder 1', classes: indentClass},
            value: {html: _self.notificationStatus(
                survey.notifyApiResponsesMatching(
                    constant('App\\Utility\\AlphagovNotify\\Reference::EVENT_REMINDER_1'),
                    'Ghost\\GovUkCoreBundle\\Messenger\\AlphagovNotify\\Email',
                    true
                ),
                pendingNotifications.pendingReminder1Emails | default([]),
                true
            )}
        }) -}}
        {{- summaryListRow({
            key: {text: 'Reminder 2', classes: indentClass},
            value: {html: _self.notificationStatus(
                survey.notifyApiResponsesMatching(
                    constant('App\\Utility\\AlphagovNotify\\Reference::EVENT_REMINDER_2'),
                    'Ghost\\GovUkCoreBundle\\Messenger\\AlphagovNotify\\Email',
                    true
                ),
                pendingNotifications.pendingReminder2Emails | default([]),
                true
            )}
        }) -}}
    {{- summaryListEnd() -}}

    {%- set manualReminders = survey.notifyApiResponsesMatching(
        constant('App\\Utility\\AlphagovNotify\\Reference::EVENT_MANUAL_REMINDER'),
        'Ghost\\GovUkCoreBundle\\Messenger\\AlphagovNotify\\Email',
        true,
        true
    ) -%}

    {%- set pendingManualReminders = pendingNotifications.pendingManualReminderEmails | default([]) -%}

    {% if manualReminders | length > 0 or pendingManualReminders | length > 0 %}
        {{- summaryListStart({classes: 'govuk-!-margin-bottom-' ~ (marginBottom ?? 9)}) -}}
            {{- summaryListRow({
                key: {text: 'Manual reminders', classes: indentClass},
                value: ''
            }) -}}
            {% for reminder in manualReminders %}
                {{- summaryListRow({
                    key: {text: "Reminder #{loop.index}", classes: indentClass},
                    value: {html: _self.notificationStatus([reminder], [], true)}
                }) -}}
            {% endfor %}
            {% for pendingReminder in pendingManualReminders %}
                {{- summaryListRow({
                    key: {text: "Reminder #{manualReminders | length + loop.index}", classes: indentClass},
                    value: {html: _self.notificationStatus([], [pendingReminder], true)}
                }) -}}
            {% endfor %}
        {{- summaryListEnd() -}}
        {% endif %}
{% endif %}

{%- macro combinedEmailDisplay(invitationEmails, lcniInfo) -%}
    {%- from '@GhostGovUkFrontend/components/macros.html.twig' import tag -%}
    {%- set hasContent = false -%}
    {%- set hasLocalEmails = invitationEmails | length > 0 -%}

    {# Local invitation emails #}
    {%- for email in invitationEmails -%}
        {%- set hasContent = true -%}
        <div class="govuk-!-margin-bottom-1">
            {%- if is_email_blacklisted(email) %}{{ tag({text: 'Blacklisted', classes: 'govuk-tag--red'}) }} {% endif -%}
            {{- email }}
        </div>
    {%- endfor -%}

    {# LCNI locked state #}
    {%- if lcniInfo.locked ?? false -%}
        {%- set hasContent = true -%}
        <div class="govuk-!-margin-bottom-1{% if hasLocalEmails %} govuk-!-margin-top-2{% endif %}">{{ tag({text: 'LCNI', classes: 'govuk-tag--yellow'}) }} Lookup temporarily unavailable; DVLA sample import in progress</div>
    {# LCNI emails with tag #}
    {%- elseif lcniInfo.emails ?? false -%}
        {%- for email in lcniInfo.emails -%}
            {%- set hasContent = true -%}
            <div class="govuk-!-margin-bottom-2{% if loop.first and hasLocalEmails %} govuk-!-margin-top-2{% endif %}">
                {%- if is_email_blacklisted(email) %}{{ tag({text: 'Blacklisted', classes: 'govuk-tag--red'}) }} {% endif -%}
                {{- tag({text: 'LCNI', classes: 'govuk-tag--blue'}) }} {{ email }}
            </div>
        {%- endfor -%}
    {%- endif -%}

    {%- if not hasContent -%}-{%- endif -%}
{%- endmacro -%}

{%- macro notificationStatus(apiResponses, pendingItems, displayRecipient) -%}
    {%- from '@GhostGovUkFrontend/components/macros.html.twig' import tag -%}
    {%- set hasContent = (apiResponses | length > 0) or (pendingItems | length > 0) -%}
    {%- if apiResponses -%}
        {% for response in apiResponses %}
            <div class="api-response">
                {%- set status = response.data[constant('App\\EventSubscriber\\AlphagovNotifyMessengerSubscriber::STATUS_KEY')] -%}
                {{- tag({text: status, classes: ("admin.notify.status.#{status}" | trans)}) -}}
                <span class="govuk-body-s">
                    <span class="api-response__timestamp">{{ response.timestamp | date('format.date-time.default' | trans) -}}</span>
                    {%- if displayRecipient | default(false) -%}<span class="api-response__recipient">{{ response.recipient }}</span>{% endif %}
                    {%- if status != constant('App\\Utility\\AlphagovNotify\\Reference::STATUS_ACCEPTED') -%}
                        {%- for error in response.data.errors -%}
                            <br>{{- error.error }}: {{ error.message | nl2br -}}
                        {%- endfor -%}
                    {%- endif -%}
                </span>
            </div>
        {% endfor %}
    {%- endif -%}
    {%- for pending in pendingItems -%}
        <div class="api-response">
            {{- tag({text: 'pending', classes: 'govuk-tag--yellow'}) -}}
            <span class="govuk-body-s">
                <span class="api-response__timestamp">sends {{ pending.availableAt | date('format.date-time.default' | trans) -}}</span>
                {%- if displayRecipient | default(false) and pending.recipient | default(false) -%}<span class="api-response__recipient">{{ pending.recipient }}</span>{% endif %}
            </span>
        </div>
    {%- endfor -%}
    {%- if not hasContent -%}
        -
    {%- endif -%}
{%- endmacro -%}
