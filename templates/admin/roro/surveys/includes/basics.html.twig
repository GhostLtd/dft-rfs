{%- from '@GhostGovUkFrontend/components/macros.html.twig' import actionlessSummaryListRow, tag -%}

<dl class="govuk-summary-list govuk-!-margin-bottom-{{ marginBottom ?? 9 }}">
    {{- actionlessSummaryListRow('admin.roro.survey.survey-start.label', survey.surveyPeriodStart | date('format.date.year-and-month' | trans)) -}}
    {{- actionlessSummaryListRow('admin.roro.survey.operator.label', survey.operator.name) -}}

    {{- actionlessSummaryListRow('admin.roro.survey.route.label', 'roro.route' | trans({
        ukPort: survey.route.ukPort.name,
        foreignPort: survey.route.foreignPort.name,
    })) -}}

    {%- if showStatus ?? true -%}
        {% set status -%}
            {{ tag({text: survey.state, classes: "admin.survey.state.#{survey.state}" | trans}) }}
        {%- endset %}
        {{ actionlessSummaryListRow('Status', status, {html: true}) }}
        {% if approvedBy | default(false) %}{{ actionlessSummaryListRow('Approved by', "#{approvedBy['username'] | removeEmailNamespacePrefix} (#{approvedBy['timestamp'] | date('format.date-time.default' | trans)})") }}{% endif %}
    {%- endif -%}
{#    {{ actionlessSummaryListRow('Contact with haulier', survey.chasedCount) }}#}
</dl>