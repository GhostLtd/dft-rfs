{% extends 'admin/base-with-nav.html.twig' %}

{% set translation_prefix = "admin.operator-groups" %}

{% block extraHeadingClasses %}govuk-!-margin-bottom-2{% endblock %}

{% block adminContent %}
    {% from '@GhostGovUkFrontend/components/macros.html.twig' import tableHead, tableCell, tableRowComplex, actionLinks, tag %}
    {%- from 'admin/macros/list-page.html.twig' import listTableStart, listTableEnd -%}

    {{ listTableStart(data, form) }}

    <p class="govuk-body govuk-!-margin-bottom-5">
        <a href="{{ path('admin_operator_groups_add_start') }}" class="govuk-link">{{ 'admin.operator-groups.list.add' | trans }}</a>
    </p>

    {% for operatorGroup in data.entities %}
        <tr class="govuk-table__row">
            {{ tableCell(operatorGroup.name ?? '-', {}) }}

            {%- set links = {} -%}
            {%- set links = links | merge({
                (path('admin_operator_groups_edit_start', {operatorGroupId: operatorGroup.id})): {
                    label: ('admin.operator-groups.list.edit' | trans),
                    srHiddenSuffix: 'admin.operator-groups.list.edit-hidden-suffix' | trans({name: operatorGroup.name})
                },
                (path('admin_operator_groups_view', {operatorGroupId: operatorGroup.id})): {
                    label: ('admin.operator-groups.list.view' | trans),
                    srHiddenSuffix: 'admin.operator-groups.list.view-hidden-suffix' | trans({name: operatorGroup.name})
                },
            }) -%}

            {{- tableCell(links is empty ? '' : actionLinks(links)) -}}
        </tr>
    {% else %}
        {{ tableRowComplex({('admin.operator-groups.list.no-results' | trans): {colSpan: data.fields|length + 1}}) }}
    {% endfor %}
    {{ listTableEnd(data, form) }}
{% endblock %}
