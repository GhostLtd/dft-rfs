{% extends 'admin/base-with-nav.html.twig' %}

{% set translation_prefix = "admin.operators" %}

{% block extraHeadingClasses %}govuk-!-margin-bottom-2{% endblock %}

{% block adminContent %}
    {% from '@GhostGovUkFrontend/components/macros.html.twig' import tableHead, tableCell, tableRowComplex, actionLinks, tag %}
    {%- from 'admin/macros/list-page.html.twig' import listTableStart, listTableEnd -%}

    {{ listTableStart(data, form) }}

    <p class="govuk-body govuk-!-margin-bottom-5">
        <a href="{{ path('admin_operators_add') }}" class="govuk-link">Add operator</a>
    </p>

    {% for operator in data.entities %}
        <tr class="govuk-table__row">
            {{ tableCell(operator.name ?? '-', {}) }}
            {{ tableCell(operator.code ?? '-', {}) }}
            {{ tableCell(operator.isActive ? 'Yes' : 'No') }}

            {%- set links = {} -%}
            {%- set links = links | merge({
                (path('admin_operators_view', {operatorId: operator.id})): {
                    label: 'view',
                    srHiddenSuffix: "operator #{operator.name}"
                }
            }) -%}

{#            {%- if is_granted('CAN_EDIT_OPERATOR', operator) -%}#}
{#                {%- set links = links | merge({#}
{#                    (path('admin_operators_edit', {operatorId: operator.id})): {#}
{#                        label: 'edit',#}
{#                        srHiddenSuffix: "operator #{operator.name}"#}
{#                    }#}
{#                }) -%}#}
{#            {%- endif -%}#}
{#            {%- if is_granted('CAN_DELETE_OPERATOR', operator) -%}#}
{#                {%- set links = links | merge({#}
{#                    (path('admin_operators_delete', {operatorId: operator.id})): {#}
{#                        label: 'delete',#}
{#                        srHiddenSuffix: "operator #{operator.name}"#}
{#                    }#}
{#                }) -%}#}
{#            {%- endif -%}#}
            {{- tableCell(links is empty ? '' : actionLinks(links)) -}}
        </tr>
    {% else %}
        {{ tableRowComplex({"No results": {colSpan: data.fields|length + 1}}) }}
    {% endfor %}
    {{ listTableEnd(data, form) }}
{% endblock %}
