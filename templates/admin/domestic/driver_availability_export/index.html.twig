{% extends 'admin/base-with-nav.html.twig' %}

{% set translation_prefix = "domestic.driver-availability-export" %}
{% set headingDomain = 'admin' %}

{%- block adminContent -%}
    {%- from '@GhostGovUkFrontend/components/macros.html.twig' import tableCell, tableHead, actionLinks -%}

    {%- set headers = ['Exported at', ''] -%}

    <table class="govuk-table govuk-!-margin-bottom-{{ marginBottom ?? 9 }}">
        {{- tableHead(false, headers) -}}
        <tbody class="govuk-table__body">
        <tr class="govuk-table__row">
            {{- tableCell('All') -}}
            {%- set actions -%}
                <a href="{{ url('admin_domestic_driveravailabilityexport_all') }}" class="govuk-!-margin-bottom-0">Download</a>
            {%- endset -%}
            {{- tableCell(actions, {actions: true}) -}}
        </tr>
        {% for exportDate in existingExportDates %}
            <tr class="govuk-table__row">
                {{- tableCell(exportDate | date('format.date-time.default' | trans)) -}}

                {%- set actions -%}
                    <a href="{{ url('admin_domestic_driveravailabilityexport_existing', {date: exportDate | date('c')}) }}" class="govuk-!-margin-bottom-0">Download</a>
                {%- endset -%}

                {{- tableCell(actions, {actions: true}) -}}
            </tr>
        {%- endfor -%}
        {% if hasNewResponses %}
            <tr class="govuk-table__row">
                {{- tableCell('Latest') -}}
                {%- set actions -%}
                    <a href="{{ url('admin_domestic_driveravailabilityexport_new') }}" class="govuk-!-margin-bottom-0">Download</a>
                {%- endset -%}
                {{- tableCell(actions, {actions: true}) -}}
            </tr>
        {% else %}
            <tr>
                {{- tableCell('There have been no new responses since the last export') -}}
                {{- tableCell('') -}}
            </tr>
        {% endif %}
        </tbody>
    </table>
{%- endblock -%}