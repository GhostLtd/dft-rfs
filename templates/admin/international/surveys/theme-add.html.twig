{% block form %}
    {{ form_start(form) }}
    {{ form_errors(form) }}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half-from-desktop govuk-!-margin-bottom-4"
             data-lcni-lookup
             data-lcni-input="#{{ form.company.businessName.vars.id }}"
             data-lcni-emails-input="#{{ form.invitationEmails.vars.id }}"
             data-lcni-survey-type="irhs"
             data-email-blacklist-check
             data-email-blacklist-input="#{{ form.invitationEmails.vars.id }}">
            {{ form_row(form.company.businessName) }}
            <div data-lcni-display class="govuk-inset-text lcni-display--hidden"></div>
            {{ form_row(form.referenceNumber) }}
            {{ form_row(form.surveyPeriodStart) }}
            {{ form_row(form.surveyPeriodEnd) }}
            {{ form_row(form.invitationEmails) }}
            <div data-email-blacklist-display class="govuk-inset-text email-blacklist-display--hidden"></div>
        </div>
        <div class="govuk-grid-column-one-half-from-desktop govuk-!-margin-bottom-4">
            {{ form_row(form.invitationAddress) }}
        </div>
    </div>
    {{ form_rest(form) }}
    {{ form_end(form) }}
{% endblock %}