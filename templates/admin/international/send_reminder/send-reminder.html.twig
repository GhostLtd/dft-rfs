{% extends 'admin/base-with-nav.html.twig' %}

{% set translation_prefix = "admin.send-reminder" %}

{%- from '@GhostGovUkFrontend/components/macros.html.twig' import actionlessSummaryListRow, warningText -%}

{% block adminContent %}
    <div class="govuk-width-container">
        {%- with {marginBottom: 0, survey: subject} -%}
            {%- include "admin/international/includes/survey-basics.html.twig" -%}
            <dl class="govuk-summary-list govuk-!-margin-bottom-9">
                {{- actionlessSummaryListRow('admin.send-reminder.recipients', recipients) -}}
            </dl>
        {%- endwith -%}

        {{ warningText((translation_prefix ~ '.warning')|trans) }}

        {{ form(form) }}
    </div>
{% endblock %}
