{% extends 'admin/base-with-nav.twig' %}

{%- block adminContent -%}
    {%- from '@GhostGovUkFrontend/components/macros.html.twig' import warningText -%}

    {%- with {user: subject} -%}
        <h1 class="govuk-heading-l" id="top">{{ "#{translation_prefix}.title"|trans }}</h1>

        {%- with {survey: subject.internationalSurvey, showUsername: false, showStatus: false} -%}
            {%- include "admin/international/includes/survey-basics.html.twig" -%}
        {%- endwith -%}

        {{- warningText("#{translation_prefix}.confirmation"|trans) -}}

        {{- form(form) -}}
    {%- endwith -%}
{%- endblock -%}