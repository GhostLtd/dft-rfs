{% extends 'admin/base-with-nav.twig' %}

{%- block adminContent -%}
    <h1 class="govuk-heading-l" id="top">Success</h1>

    <p class="govuk-body">Export successfully generated for week {{ week }}</p>

    <a href="{{ url('admin_international_export_download', {week: week}) }}" class="govuk-button govuk-!-margin-bottom-0">Download</a>
