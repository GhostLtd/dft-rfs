{% extends 'admin/base-with-nav.html.twig' %}

{% trans_default_domain 'admin' %}
{% set headingDomain = 'admin' %}
{% set translation_prefix = "notification-interception" %}

{% block adminContent %}
    {% from '@GhostGovUkFrontend/components/macros.html.twig' import pagination, tableHead, tableRow, summaryListActionsList, tag %}
    {%- from 'admin/macros/list-page.html.twig' import listTableStart, listTableEnd -%}
    {%- from 'admin/macros/list-page-extra.html.twig' import countField, reminderDate -%}

    {{ listTableStart(data, form) }}
    {% for ni in data.entities %}
        {%- set visuallyHiddenText = "notification-interception.sr-hidden-suffix" | trans({primaryName: ni.primaryName ?? (ni.names | first).name}, 'admin') -%}
        {%- set actions = [
            {
                href: path('admin_notification_interception_edit_all', {id: ni.id}),
                text: 'notification-interception.edit-all.label' | trans({}, 'admin'),
                visuallyHiddenText: visuallyHiddenText,
            },
            {
                href: path('admin_notification_interception_delete', {id: ni.id}),
                text: 'common.actions.delete' | trans({}, 'messages'),
                visuallyHiddenText: visuallyHiddenText,
            }
        ] -%}
        {% set email_content %}
            {% if ni.csrgtEmails ?? false %}<div><b>CSRGT:</b> {{ ni.csrgtEmails }}</div>{% endif %}
            {% if ni.irhsEmails ?? false %}<div><b>IRHS:</b> {{ ni.irhsEmails }}</div>{% endif %}
            {% if ni.dvlaEmails ?? false %}<div><b>DVLA:</b>  {{ ni.dvlaEmails }}</div>{% endif %}
        {% endset %}
        {{- tableRow([
            {html: (ni.names | map(n => n.name) | join('<br>'))},
            {html: email_content},
            {html: summaryListActionsList(actions)}
        ]) -}}
    {% else %}
        {{- tableRow([
            {
                text: 'admin.operator-groups.list.no-results' | trans({}, 'messages'),
                colspan: data.fields | length + 1,
            }
        ]) -}}
    {% endfor %}
    {{ listTableEnd(data, form, false) }}

    <a class="govuk-button" href="{{ path('admin_notification_interception_add') }}">{{ "notification-interception.button.add" | trans }}</a>
    <a class="govuk-button govuk-button--secondary" href="{{ path('admin_notification_interception_dvla_import') }}">{{ "notification-interception.button.dvla_import" | trans }}</a>

    <div class="pagination-container">
        {{ pagination(data.paginationData) }}
    </div>
{% endblock %}
