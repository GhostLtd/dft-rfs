{% extends 'domestic_survey/base.html.twig' %}

{% set translation_prefix = 'domestic.completed' %}

{% block pageTitle -%}
    {%- include 'includes/form-page-title.html.twig' -%}
    {{- parent() -}}
{%- endblock %}

{% block content %}
    <div class="govuk-panel govuk-panel--confirmation">
        <h1 class="govuk-panel__title">{{ (translation_prefix ~ '.heading')|trans }}

        </h1>
        <div class="govuk-panel__body">
            {{ (translation_prefix ~ '.reference-number')|trans }}<br>
            <strong>{{ survey.surveyPeriodStart | date('Y') }}-{{ survey.registrationMark }}</strong>
        </div>
    </div>
{% endblock %}
