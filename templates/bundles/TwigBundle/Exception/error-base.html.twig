{% extends 'base.html.twig' %}

{% block pageTitle %}
    {{ (prefix ~ 'title')|trans }}
{% endblock %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading govuk-heading-xl">{{ (prefix ~ 'heading')|trans }}</h1>

            <p class="govuk-body">{{ (prefix ~ 'copy')|trans|nl2br }}</p>
        </div>
    </div>
{% endblock %}