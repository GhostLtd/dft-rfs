{% set translation_prefix = 'international.action.summary' %}
{% set containerClasses = '' %}
{% extends 'international_survey/base.html.twig' %}

{% block content %}
    {%- from '@GhostGovUkFrontend/components/macros.html.twig' import summaryListRow, actionLinks -%}

    <h1 class="page-heading__heading govuk-heading-xl">
        {%- if action.loading -%}
            {{ 'international.action.summary.heading-loading'|trans({number: action.number}) }}
        {%- else -%}
            {{ 'international.action.summary.heading-unloading'|trans({number: action.number}) }}
        {%- endif -%}
    </h1>

    {%- set params = {actionId: action.id} -%}
    {%- set urlChange = wizardUrl('international-action', 'STATE_PLACE', params) -%}

    {%- set change = 'common.actions.change'|trans -%}

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <dl class="govuk-summary-list govuk-!-margin-bottom-9">
                {%- set cargoChoices = constant('App\\Entity\\CargoType::CHOICES') -%}
                {%- set loadingAction = action.loadingAction -%}

                {{ summaryListRow('common.action.place', 'common.action.place-name' | trans({name: action.name, country: action|formatCountry}), {(urlChange): change}) }}
                {%- if action.loading -%}
            {# Loading #}
                    {%- set urlLoadGoodsChange = wizardUrl('international-action', 'STATE_GOODS_DESCRIPTION', params) -%}
                    {%- set urlLoadHazardousChange = wizardUrl('international-action', 'STATE_HAZARDOUS_GOODS', params) -%}

                    {{ summaryListRow('common.action.goods', formatGoodsDescription(action.goodsDescription, action.goodsDescriptionOther), {(urlLoadGoodsChange): change}) }}
                    {{ summaryListRow('common.action.weight', (action.weightOfGoods|number_format) ~ 'kg', {(urlLoadGoodsChange): change}) }}

                    {%- set hazardousGoodsChoices = constant('App\\Entity\\HazardousGoods::CHOICES') -%}
                    {%- set hazardousGoodsCopy -%}
                        {%- if action.hazardousGoodsCode -%}
                            <em>{{ action.hazardousGoodsCode }}</em> - {{ choiceLabel(flatten(hazardousGoodsChoices), action.hazardousGoodsCode)|trans }}
                        {%- else -%}
                            {{ 'common.action.not-hazardous'|trans }}
                        {%- endif -%}
                    {%- endset %}
                    {{ summaryListRow('common.action.is-hazardous', hazardousGoodsCopy, {(urlLoadHazardousChange): change}) }}
                    {{ summaryListRow('common.action.cargo-type', choiceLabel(cargoChoices, action.cargoTypeCode) | trans, {(urlLoadHazardousChange): change}) }}
                {%- else -%}
            {# Unloading #}
                    {%- set urlUnloadConsignmentChange = wizardUrl('international-action', 'STATE_CONSIGNMENT_UNLOADED', params) -%}
                    {% with {action: action.loadingAction} %}
                        {%- set goodsCopy = 'common.action.goods-from-place'|trans({name: action.name, country: action|formatCountry, number: loadingAction.number, goods: formatGoodsDescription(loadingAction.goodsDescription, loadingAction.goodsDescriptionOther)}) -%}
                        {{ summaryListRow('common.action.goods', goodsCopy, {(urlUnloadConsignmentChange): change}) }}
                    {% endwith %}
                    {% if action.weightUnloadedAll %}
                        {{ summaryListRow('common.action.weight', 'common.action.unloaded-all'|trans({weight: (action.loadingAction.weightOfGoods|number_format) ~ 'kg'}), {(urlUnloadConsignmentChange): change}) }}
                    {% else %}
                        {{ summaryListRow('common.action.weight', (action.weightOfGoods|number_format) ~ 'kg', {(urlUnloadConsignmentChange): change}) }}
                    {% endif %}
                {%- endif -%}
            </dl>
            {%- set deleteRoute = constant('App\\Controller\\InternationalSurvey\\ActionController::DELETE_ROUTE') -%}
            {%- set dashboardRoute = constant('App\\Controller\\InternationalSurvey\\TripController::TRIP_ROUTE') -%}
            <a href="{{ url(dashboardRoute, {id: action.trip.id}) }}" class="govuk-button govuk-button--secondary">{{ 'international.action.summary.actions.back-to-trip-summary'|trans }}</a>
            <a href="{{ url(deleteRoute, {actionId: action.id}) }}" class="govuk-button govuk-button--warning">{{ 'international.action.summary.actions.delete'|trans }}</a>
        </div>
{#
        <div class="govuk-grid-column-one-third">
            {% with {trip: action.trip} %}
                {% include "international_survey/includes/trip-summary.html.twig" %}
            {% endwith %}
        </div>
#}
    </div>
{% endblock %}