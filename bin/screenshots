#!/usr/bin/env bash
# Runs the screenshot tool (bin/console rfs:dev:screenshots) in a disposable Compose stack: an empty MySQL 8.0.18 and
# an image with the app served over HTTPS plus Puppeteer's Chrome. No .env.local editing needed.
#
#   bin/screenshots                 # all survey types
#   bin/screenshots pre-enquiry     # one of: all, domestic, international, pre-enquiry, roro
#   SCREENSHOTS_FEATURES=outward-code-check bin/screenshots domestic   # place-name location mode
#
# Screenshots go to screenshots/output/<timestamp>/. Each run gets its own Compose project and image tag, and
# everything is removed afterwards. Exits with the screenshot command's status.
set -euo pipefail
cd "$(dirname "$0")/.."

export RFS_TEST_RUN="$(date +%s)-$$-${RANDOM}"
export RFS_UID="$(id -u)" RFS_GID="$(id -g)"
project="rfs-screenshots-${RFS_TEST_RUN}"
compose=(docker compose --project-name "$project" --file compose.screenshots.yaml)

cleanup() {
    "${compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
    # Removes only this run's tag; the layers stay in the build cache
    docker image rm "rfs-screenshots:${RFS_TEST_RUN}" >/dev/null 2>&1 || true
}
trap cleanup EXIT

# Created here so Docker doesn't create it (as root) for the bind mount
mkdir -p screenshots/output

"${compose[@]}" build screenshots

status=0
"${compose[@]}" run --rm screenshots "$@" || status=$?
exit "$status"
