<details {%- if params.id %} id="{{params.id}}"{% endif %} class="govuk-details {%- if params.classes %} {{ params.classes }}{% endif %}" data-module="govuk-details" {%- for attribute, value in params.attributes %} {{attribute}}="{{value}}"{% endfor %} {% if params.open ?? null %}{{ ' open' }}{% endif %}>
<summary class="govuk-details__summary">
    <span class="govuk-details__summary-text">
        {{ (params.summaryHtml ?? null) ? (params.summaryHtml | raw) : params.summaryText }}
    </span>
</summary>
<div class="govuk-details__text">
    {{ (params.html ?? null) ? (params.html | raw) : params.text }}
</div>
</details>